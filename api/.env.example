# Server-side only. NEVER expose SUPABASE_SECRET_KEY to the frontend/browser.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# TODO: fill this in from Supabase Project Settings > Database > Connection string.
# You need the actual Postgres password for this project (not the API secret key above).
# Direct connection (use for running migrations):
#   postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres
# Pooled connection via pgbouncer (use for the running app in serverless/high-concurrency environments):
#   postgresql://postgres:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.your-project.supabase.co:5432/postgres"

# Frontend origin allowed to call this API (CORS).
CORS_ORIGIN=http://localhost:5173

NODE_ENV=development
PORT=3001
